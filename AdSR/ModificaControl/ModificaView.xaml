<Window x:Class="AdSR.ModificaControl.ModificaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdSR.ModificaControl"
        xmlns:common="clr-namespace:AdSR.Common"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Modifica Marsau" Height="800" Width="1300"
        Background="#0F2044"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="Gold" Color="#C9A84C"/>
        <SolidColorBrush x:Key="GoldLight" Color="#E8C97A"/>
        <SolidColorBrush x:Key="NavyDark" Color="#0F2044"/>
        <SolidColorBrush x:Key="NavyMedium" Color="#2A456E"/>

        <common:TroncaMarsauConverter x:Key="TroncaMarsauConverter"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#162840"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
        </Style>

        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F2044"/>
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="CancelButtonStyle" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource NavyDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource NavyMedium}"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2" Padding="16,12">
            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Gold}">
                <Run Text="Modifica Marsau - "/>
                <Run Text="{Binding MarsauSelezionato.Marsau, Converter={StaticResource TroncaMarsauConverter}, Mode=OneWay}"/>
            </TextBlock>
        </Border>

        <!-- CONTENUTO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,10,0,10">
            <StackPanel Width="1100" HorizontalAlignment="Center">

                <!-- ══════════ DATI IDENTIFICATIVI ══════════ -->
                <TextBlock Text="▸ DATI IDENTIFICATIVI" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Riga: Marsau, Data Marsau -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Marsau:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Marsau, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Marsau:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.MarsauData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: Ditta, RDO -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ditta:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Ditta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RDO:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Rdo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ ARGOMENTO (riquadro evidenziato, multilinea) ══════════ -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Argomento:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Argomento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource InputStyle}"
             TextWrapping="Wrap"
             AcceptsReturn="True"
             Height="120"
             VerticalScrollBarVisibility="Auto"
             VerticalContentAlignment="Top"/>
                </StackPanel>

                <!-- Riga: Atto, Contratto -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Atto:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Atto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Contratto:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Contratto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: Data Introduzione -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Data Introduzione:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.DataIntroduzione, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- ══════════ RICHIESTA E IMPORTI ══════════ -->
                <TextBlock Text="▸ RICHIESTA E IMPORTI" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Riga: Richiesta, Lotto -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Richiesta:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Richiesta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Lotto:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Lotto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: Importo, Giorni, RIC -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Importo:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Importo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Giorni:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Giorni, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="RIC:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Ric, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ FORNITURE E SISTEMA ══════════ -->
                <TextBlock Text="▸ FORNITURE E SISTEMA" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Forniture:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.Forniture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Siga45:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.Siga45, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- ══════════ CRE / DDT / JOSH ══════════ -->
                <TextBlock Text="▸ CRE / DDT / JOSH" Style="{StaticResource SectionHeaderStyle}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CRE:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Cre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data CRE:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataCre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Josh:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Josh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DDT (Documento di Trasporto):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Ddt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data DDT:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataDdt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ FATTURAZIONE ══════════ -->
                <TextBlock Text="▸ FATTURAZIONE" Style="{StaticResource SectionHeaderStyle}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fattura:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Fattura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Fattura:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataFattura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Importo Fattura:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.ImportoFattura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ BDC / COLLAUDO ══════════ -->
                <TextBlock Text="▸ BDC / COLLAUDO" Style="{StaticResource SectionHeaderStyle}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BDC:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Bdc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data BDC:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataBdc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Collaudo:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Collaudo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ ALTRO ══════════ -->
                <TextBlock Text="▸ ALTRO" Style="{StaticResource SectionHeaderStyle}"/>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="PdC (Piano di Classificazione):" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.PdC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Cartella:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.Cartella, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- Note -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Note:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- BARRA PULSANTI FISSA IN BASSO -->
        <Border Grid.Row="2" Background="{StaticResource NavyMedium}"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,2,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Style="{StaticResource ButtonStyle}"
                        Command="{Binding SalvaCommand}"
                        Padding="20,8"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,2 L12,2 L14,4 L14,14 L2,14 Z
                                    M5,2 L5,7 L11,7 L11,2
                                    M4,9 L12,9 L12,14 L4,14 Z"
                              Stroke="#0F2044"
                              StrokeThickness="1.6"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="SALVA MODIFICHE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CancelButtonStyle}"
                        Command="{Binding AnnullaCommand}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Stroke="#FFFFFF"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="ANNULLA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>