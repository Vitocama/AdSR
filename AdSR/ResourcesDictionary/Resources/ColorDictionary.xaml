<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ COLORI E GRADIENTI ═══ -->
    <SolidColorBrush x:Key="Gold"       Color="#C9A84C"/>
    <SolidColorBrush x:Key="GoldLight"  Color="#E8C97A"/>
    <SolidColorBrush x:Key="NavyDark"   Color="#0F2044"/>
    <SolidColorBrush x:Key="NavyMedium" Color="#2A456E"/>

    <LinearGradientBrush x:Key="MainGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F2044" Offset="0"/>
        <GradientStop Color="#162D5C" Offset="0.5"/>
        <GradientStop Color="#1A3870" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldLineGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00C9A84C" Offset="0"/>
        <GradientStop Color="#C9A84C"   Offset="0.3"/>
        <GradientStop Color="#C9A84C"   Offset="0.7"/>
        <GradientStop Color="#00C9A84C" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══ COLORI MARINA MESSAGEBOX ═══ -->
    <SolidColorBrush x:Key="MsgGold"      Color="#C9A84C"/>
    <SolidColorBrush x:Key="MsgGoldLight" Color="#E8C97A"/>

    <LinearGradientBrush x:Key="MsgGoldLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00C9A84C" Offset="0"/>
        <GradientStop Color="#C9A84C"   Offset="0.3"/>
        <GradientStop Color="#C9A84C"   Offset="0.7"/>
        <GradientStop Color="#00C9A84C" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══ PULSANTE ORO ═══ -->
    <Style TargetType="Button" x:Key="GoldButton">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0F2044"/>
        <Setter Property="Background" Value="{StaticResource Gold}"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ STILE PREDEFINITO per tutti i Button senza stile ═══ -->
    <Style TargetType="Button">
        <Setter Property="Width" Value="255"/>
        <Setter Property="Height" Value="70"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            CornerRadius="5"
                            BorderBrush="Black"
                            BorderThickness="3"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: sfondo + scritta nera -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1A2F4E" Offset="0.0"/>
                                        <GradientStop Color="#2A4A6B" Offset="0.5"/>
                                        <GradientStop Color="#1A2F4E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>

                        <!-- Pressed: sfondo + scritta nera -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF16344B" Offset="0.0"/>
                                        <GradientStop Color="#FF385475" Offset="0.5"/>
                                        <GradientStop Color="#FF2E5C83" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="Gray"/>
                            <Setter Property="Foreground" Value="DarkGray"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- Colore di default del pulsante -->
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A3568" Offset="0.0"/>
                    <GradientStop Color="#3A6BA4" Offset="0.1111"/>
                    <GradientStop Color="#0A3568" Offset="0.5"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ PULSANTE NAVY ═══ -->
    <Style x:Key="NavyButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="180"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A2F4E" Offset="0.0"/>
                    <GradientStop Color="#2A4A6B" Offset="0.5"/>
                    <GradientStop Color="#1A2F4E" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#E8EEF5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2A4A6B" Offset="0.0"/>
                                        <GradientStop Color="#3A6A9B" Offset="0.5"/>
                                        <GradientStop Color="#2A4A6B" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#060F1A" Offset="0.0"/>
                                        <GradientStop Color="#0F1F35" Offset="0.5"/>
                                        <GradientStop Color="#060F1A" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ PULSANTI PILL ═══ -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Background"      Value="#2980B9"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="Height"          Value="30"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="15"
                            Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A6A9A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButtonGreen" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="#27AE60"/>
    </Style>

    <Style x:Key="PillButtonGray" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="#7F8C8D"/>
    </Style>

    <!-- ═══ PULSANTE PILL OUTLINE (filtri stato) ═══ -->
    <Style x:Key="PillOutline" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderBrush"     Value="#BDC3C7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="Height"          Value="30"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15"
                            Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#ECF0F1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Color x:Key="CGold">#C9A44C</Color>
    <Color x:Key="CGoldLight">#E9CF8A</Color>
    <Color x:Key="CNavyDeep">#0A1630</Color>

    <SolidColorBrush x:Key="MbGold"      Color="{StaticResource CGold}"/>
    <SolidColorBrush x:Key="MbGoldLight" Color="{StaticResource CGoldLight}"/>
    <SolidColorBrush x:Key="MbText"      Color="#E8EEF5"/>
    <SolidColorBrush x:Key="MbTextDim"   Color="#8FA3BF"/>

    <LinearGradientBrush x:Key="MbCardBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#16305E" Offset="0"/>
        <GradientStop Color="#0F2044" Offset="0.45"/>
        <GradientStop Color="#0A1630" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MbCardBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3C9A44C" Offset="0"/>
        <GradientStop Color="#33C9A44C" Offset="1"/>
    </LinearGradientBrush>

    <!-- Filo oro sfumato ai lati -->
    <LinearGradientBrush x:Key="MbGoldRule" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00C9A44C" Offset="0"/>
        <GradientStop Color="#FFC9A44C" Offset="0.2"/>
        <GradientStop Color="#FFE9CF8A" Offset="0.5"/>
        <GradientStop Color="#FFC9A44C" Offset="0.8"/>
        <GradientStop Color="#00C9A44C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MbGoldFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0D58F" Offset="0"/>
        <GradientStop Color="#C9A44C" Offset="1"/>
    </LinearGradientBrush>

    
    <SolidColorBrush x:Key="RowDark" Color="#162840"/>
    <SolidColorBrush x:Key="RowMedium" Color="#1A3A52"/>

    
   
</ResourceDictionary>