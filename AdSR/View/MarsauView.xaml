<Window x:Class="AdSR.MarsauControl.MarsauView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdSR"
        xmlns:common="clr-namespace:AdSR.Common"
        mc:Ignorable="d"
        Title="Gestione Marsau" Height="800" Width="1400"
        Background="#0F2044"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
   

    <Window.Resources>
        <common:TroncaMarsauConverter x:Key="TroncaMarsauConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="Gold" Color="#C9A84C"/>
        <SolidColorBrush x:Key="GoldLight" Color="#E8C97A"/>
        <SolidColorBrush x:Key="NavyDark" Color="#0F2044"/>
        <SolidColorBrush x:Key="NavyMedium" Color="#2A456E"/>
        <SolidColorBrush x:Key="RowDark" Color="#162840"/>
        <SolidColorBrush x:Key="RowMedium" Color="#1A3A52"/>

        <Style x:Key="FormDatePickerStyle" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="{StaticResource RowDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- =========== STILI TESTO =========== -->
        <Style x:Key="WindowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="Margin" Value="16,12"/>
        </Style>

        <Style x:Key="SearchLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- =========== STILI CAMPI =========== -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource RowDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource RowDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="FormMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Height" Value="100"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ============================================================
             COMBOBOX STYLE - Tema Navy/Oro
             ============================================================ -->

        <!-- Stile per i singoli ComboBoxItem -->
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource NavyDark}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#162D5C"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource NavyDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile principale del ComboBox (coerente con FormTextBoxStyle) -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource RowDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bordo principale -->
                            <Border x:Name="MainBorder"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"/>

                            <!-- ToggleButton trasparente che apre il popup -->
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Testo dell'elemento selezionato -->
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>

                            <!-- Freccia -->
                            <Path x:Name="Arrow"
                                  Grid.Column="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 8 0 L 4 5 Z"
                                  Fill="{StaticResource Gold}"
                                  IsHitTestVisible="False"/>

                            <!-- Popup con la lista -->
                            <Popup x:Name="Popup"
                                   Grid.ColumnSpan="2"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource NavyDark}"
                                            BorderBrush="{StaticResource Gold}"
                                            BorderThickness="1"
                                            CornerRadius="0,0,3,3"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource GoldLight}"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource GoldLight}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource GoldLight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========== STILI PULSANTI =========== -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource NavyDark}"/>
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource GoldLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#888888"/>
        </Style>

        <!-- =========== STILI DATAGRID =========== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource RowMedium}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource RowMedium}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource RowDark}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="VerticalGridLinesBrush" Value="Yellow"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Yellow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource NavyMedium}"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#30C9A84C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="48"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20C9A84C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cella speciale per il campo MARSAU (evidenziato) -->
        <Style x:Key="MarsauCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource NavyDark}">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource NavyMedium}"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2">
            <Grid>
                <TextBlock Text="Gestione Marsau" Style="{StaticResource WindowTitleStyle}"/>
                <TextBlock Text="{Binding MarsauFiltratiLista.Count, StringFormat='{}{0} record'}"
                           Foreground="{StaticResource GoldLight}"
                           FontSize="16"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,20,0"/>
            </Grid>
        </Border>

        <!-- TOOLBAR RICERCA -->
        <Border Grid.Row="1" Background="{StaticResource NavyMedium}"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Cerca:" Style="{StaticResource SearchLabelStyle}"/>
                <TextBox Text="{Binding FiltroRicerca, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Cerca"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding SearchCommand}"/>
                <Button Content="+ Aggiungi Marsau"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AggiungiCommand}"/>
            </StackPanel>
        </Border>

        <!-- CONTENUTO: DataGrid oppure Form -->
        <Grid Grid.Row="2">

            <!-- ========== DATAGRID ========== -->
            <DataGrid x:Name="DataGridMarsau"
                      ItemsSource="{Binding MarsauFiltratiLista}"
                      SelectedItem="{Binding MarsauSelezionato}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      ColumnWidth="500"
                      Visibility="{Binding IsFormVisible, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                      Margin="12"
                      RowHeight="48"
                      FontSize="20">

                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding apriDatiMarsau}"/>
                </DataGrid.InputBindings>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="DITTA" Binding="{Binding Ditta}" />

                    <!-- MARSAU evidenziato -->
                    <DataGridTextColumn Header="MARSAU"
                                        Binding="{Binding Marsau, Converter={StaticResource TroncaMarsauConverter}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MarsauCellStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="DATA MARSAU" Binding="{Binding MarsauData}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- ========== FORM INSERIMENTO ========== -->
            <Border x:Name="BorderForm"
                    Background="{StaticResource NavyDark}"
                    Margin="12"
                    Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="1100" Margin="0,10,0,20">

                        <!-- Titolo form -->
                        <Border Background="{StaticResource NavyMedium}"
                                BorderBrush="{StaticResource Gold}"
                                BorderThickness="0,0,0,2"
                                Padding="20,14"
                                Margin="0,0,0,24">
                            <TextBlock Text="INSERISCI NUOVO MARSAU"
                                       Foreground="{StaticResource Gold}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- ══════════ DATI IDENTIFICATIVI ══════════ -->
                        <TextBlock Text="▸ DATI IDENTIFICATIVI"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Marsau:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Marsau, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data Marsau:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.MarsauData, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ditta:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ditta, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RDO(Richiesta di Offerta):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Rdo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Argomento:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding NuovoMarsau.Argomento, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Atto:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Atto, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Contratto:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Contratto, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ RICHIESTA E IMPORTI ══════════ -->
                        <TextBlock Text="▸ RICHIESTA E IMPORTI"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Richiesta:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Richiesta, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Lotto:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Lotto, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- CAPITOLO su riga dedicata -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Capitolo:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding NuovoMarsau.Capitolo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Importo:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Importo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giorni:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Giorni, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="RIC:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ric, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DEC, RUP, A.A, A.D -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DEC:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Dec, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RUP:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Rup, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="A.A:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.AA, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="A.D:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ad, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ FORNITURE E SISTEMA ══════════ -->
                        <TextBlock Text="▸ FORNITURE E SISTEMA"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Forniture:" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox SelectedValuePath="Content"
                                      SelectedValue="{Binding NuovoMarsau.Forniture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormComboBoxStyle}">
                                <ComboBoxItem Content="Parziale"/>
                                <ComboBoxItem Content="Completo"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Siga45:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding NuovoMarsau.Siga45, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <!-- ══════════ CRE / DDT / JOSH ══════════ -->
                        <TextBlock Text="▸ CRE / DDT / JOSH"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CRE:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Cre, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data CRE:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataCre, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Josh:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Josh, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DDT, Data DDT, Pervenuto -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DDT(Documento di trasporto):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ddt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data DDT:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataDdt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Pervenuto:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Pervenuto, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DDT 2, Data DDT 2, Pervenuto 2 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DDT 2:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ddt2, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data DDT 2:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataDdt2, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Pervenuto 2:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Pervenuto2, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DDT 3, Data DDT 3, Pervenuto 3 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DDT 3:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ddt3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data DDT 3:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataDdt3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Pervenuto 3:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Pervenuto3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- (vuoto sotto DDT), Data Introduzione, Trasmesso -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data Introduzione:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataIntroduzione, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Trasmesso:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Trasmesso, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ FATTURAZIONE ══════════ -->
                        <TextBlock Text="▸ FATTURAZIONE"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fattura:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Fattura, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data Fattura:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataFattura, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Importo Fattura:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.ImportoFattura, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ BDC / COLLAUDO ══════════ -->
                        <TextBlock Text="▸ BDC / COLLAUDO"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="BDC:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Bdc, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data BDC:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataBdc, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Collaudo:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Collaudo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ ALTRO ══════════ -->
                        <TextBlock Text="▸ ALTRO"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PdC (Piano di Classificazione):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.PdC, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PdG (Punto di Contratto):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.PdG, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ CARTELLA DOCUMENTI ══════════ -->
                        <TextBlock Text="▸ CARTELLA DOCUMENTI"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Percorso cartella:" Style="{StaticResource FormLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding CartellaPath}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         IsReadOnly="True"/>
                              
                            </Grid>
                        </StackPanel>

                        <!-- ══════════ NOTE ══════════ -->
                        <TextBlock Text="▸ NOTE"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <StackPanel Margin="0,0,0,24">
                            <TextBox Text="{Binding NuovoMarsau.Note, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormMultilineTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Pulsanti -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="✓ Salva"
                                    Command="{Binding SalvaCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,10,0"
                                    MinWidth="120"/>
                            <Button Content="✗ Annulla"
                                    Command="{Binding AnnullaCommand}"
                                    Style="{StaticResource CancelButtonStyle}"
                                    MinWidth="120"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
