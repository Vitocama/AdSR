<Window x:Class="AdSR.MarsauControl.MarsauView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdSR"
        xmlns:common="clr-namespace:AdSR.Common"
        mc:Ignorable="d"
        Title="Gestione Marsau" Height="800" Width="1400"
        Background="#0F2044"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">


    <Window.Resources>
        <ResourceDictionary>

            <common:TroncaMarsauConverter x:Key="TroncaMarsauConverter"/>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <!-- SFONDO: IMG/sfondo.png (Azione di compilazione = Resource) -->
        <Grid.Background>
            <ImageBrush ImageSource="/IMG/NavePa.jpeg"
                        Stretch="UniformToFill"
                        AlignmentX="Center" AlignmentY="Center"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- VELO navy sopra la foto: garantisce la leggibilità -->
        <Border Grid.RowSpan="3" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E60F2044" Offset="0"/>
                    <GradientStop Color="#B30F2044" Offset="0.4"/>
                    <GradientStop Color="#F20F2044" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#F3F3F3"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2">
            <Grid>
                <!-- SINISTRA: stemma + titolo -->
                <Grid>
                    <!-- SINISTRA -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                HorizontalAlignment="Left" Margin="16,0,0,0">
                        <Image Source="/IMG/stemma.png" Height="44" Margin="0,8,14,8"
               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Gestione Marsau" Style="{StaticResource  BlackBoldText}" FontSize="25"
                   Margin="0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- DESTRA: (resta com'è) -->

                    <!-- CENTRO -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="0,6" Padding="10,4"

            BorderBrush="{StaticResource Gold}" BorderThickness="0">
                        <Image Source="/IMG/ministero-difesa-logo.png" Height="40"
               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>

                <!-- DESTRA: numero record + logo -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="0,0,20,0">
                    <TextBlock Text="{Binding MarsauFiltratiLista.Count, StringFormat='{}{0} record'}"
                               Style="{StaticResource  DettaglioSezioneStyle}"
                               FontSize="20"
                              
                               VerticalAlignment="Center"
                               Margin="0,0,18,0"/>
                    
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOOLBAR RICERCA -->
        <Border Grid.Row="1" Background="#D92A456E"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Cerca:" Style="{StaticResource SearchLabelStyle}"/>
                <TextBox Text="{Binding FiltroRicerca, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Style="{StaticResource PrimaryButtonStyle}"
            Command="{Binding HomeCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
            ToolTip="Torna alla finestra principale"
            Padding="16,6"
            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,8 L8,2 L14,8 M4,7 L4,14 L7,14 L7,10 L9,10 L9,14 L12,14 L12,7"
                  Stroke="#0F2044"
                  StrokeThickness="1.6"
                  StrokeLineJoin="Round"
                  Fill="Transparent"
                  Width="16" Height="16"
                  Stretch="Uniform"
                  Margin="10,0,10,0"/>
                        <TextBlock Text="HOME" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Button>
                <Button Content="CERCA"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,10,0"
                        Command="{Binding SearchCommand}"/>
                <Button Content="AGGIUNGI MARSAU"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding AggiungiCommand}"/>
                <!-- Mostra/nascondi l'elenco a sinistra (nessun code-behind) -->
                <ToggleButton x:Name="BtnElenco"
                              Content="☰ Elenco"
                              IsChecked="True"
                              Style="{StaticResource ToggleElencoStyle}"/>
                
                <!-- DESTRA: numero record + HOME -->
<StackPanel Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Margin="0,0,20,0">
   

</StackPanel>
            </StackPanel>
        </Border>

        <!-- CONTENUTO: DataGrid oppure Form -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== ELENCO A SINISTRA: Ditta / Marsau / Data Marsau ========== -->
            <Border x:Name="PannelloElenco"
                    Grid.Column="0"
                    Width="320"
                    Margin="12,12,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnElenco}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ListBox x:Name="ElencoDitte"
                         ItemsSource="{Binding MarsauFiltratiLista}"
                         SelectedItem="{Binding MarsauSelezionato, Mode=TwoWay}"
                         SelectionMode="Single"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource DittaButtonItemStyle}">

                    <ListBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding apriDatiMarsau}"/>
                    </ListBox.InputBindings>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Ditta}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Ditta}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Nessun record selezionato e form chiuso: logo + messaggio -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MarsauSelezionato}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFormVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

              
                <TextBlock Text="Seleziona un record dall'elenco per vedere i dettagli&#x0A;oppure premi «+ Aggiungi Marsau»"
                           Foreground="{StaticResource GoldLight}"
                           Opacity="0.6"
                           FontSize="16"
                           FontStyle="Italic"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- ========== DETTAGLI MARSAU A DESTRA (sola lettura) ========== -->
            <ScrollViewer x:Name="PannelloDettagli"
                          Grid.Column="1"
                          Margin="12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MarsauSelezionato}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFormVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel HorizontalAlignment="Stretch" MaxWidth="1000" Margin="16,0,16,20">

                    <!-- Titolo dettagli -->
                    <Border Background="{StaticResource NavyMedium}"
                            BorderBrush="{StaticResource Gold}"
                            BorderThickness="0,0,0,2"
                            Padding="20,14"
                            Margin="0,0,0,16">
                        <TextBlock FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Gold}"
                                   HorizontalAlignment="Center">
                            <Run Text="DETTAGLI MARSAU - "/>
                            <Run Text="{Binding MarsauSelezionato.Marsau, Converter={StaticResource TroncaMarsauConverter}, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <!-- ══════════ DATI IDENTIFICATIVI ══════════ -->
                    <TextBlock Text="▸ DATI IDENTIFICATIVI" Style="{StaticResource DettaglioSezioneStyle}"/>

                    <!-- Riga: Marsau, Data Marsau -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Marsau:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Marsau, Converter={StaticResource TroncaMarsauConverter}, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data Marsau:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.MarsauData, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Riga: Ditta, RDO -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ditta:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Ditta, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RDO:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Rdo, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- ══════════ ARGOMENTO (multilinea) ══════════ -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Argomento:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Argomento, Mode=OneWay}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 IsReadOnly="True"
                                 Height="120"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <!-- Riga: Atto, Contratto -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Atto:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Atto, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contratto:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Contratto, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- ══════════ RICHIESTA E IMPORTI ══════════ -->
                    <TextBlock Text="▸ RICHIESTA E IMPORTI" Style="{StaticResource DettaglioSezioneStyle}"/>

                    <!-- Riga: Richiesta, Lotto, Capitolo -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Richiesta:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Richiesta, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lotto:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Lotto, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Capitolo:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Capitolo, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Riga: Importo, Giorni, RIC -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Importo:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Importo, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Giorni:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Giorni, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="RIC:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Ric, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Riga: DEC, RUP, A.A, A.D -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DEC:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Dec, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RUP:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Rup, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="A.A:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.AA, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="A.D:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Ad, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- ══════════ FORNITURE E SISTEMA ══════════ -->
                    <TextBlock Text="▸ FORNITURE E SISTEMA" Style="{StaticResource DettaglioSezioneStyle}"/>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Forniture:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Forniture, Mode=OneWay}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Siga45:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Siga45, Mode=OneWay}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <!-- ══════════ CRE / DDT / JOSH ══════════ -->
                    <TextBlock Text="▸ CRE / DDT / JOSH" Style="{StaticResource DettaglioSezioneStyle}"/>

                    <!-- Riga: CRE, Data CRE, Josh -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CRE:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Cre, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data CRE:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.DataCre, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Josh:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Josh, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Riga: DDT, Data DDT, Pervenuto -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DDT (Documento di Trasporto):" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Ddt, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data DDT:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.DataDdt, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Pervenuto:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Pervenuto, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Riga: DDT 2, Data DDT 2, Pervenuto 2 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DDT 2:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Ddt2, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data DDT 2:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.DataDdt2, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Pervenuto 2:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Pervenuto2, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Riga: DDT 3, Data DDT 3, Pervenuto 3 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DDT 3:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Ddt3, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data DDT 3:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.DataDdt3, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Pervenuto 3:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Pervenuto3, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Riga: (vuoto sotto DDT), Data Introduzione, Trasmesso -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data Introduzione:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.DataIntroduzione, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Trasmesso:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Trasmesso, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- ══════════ FATTURAZIONE ══════════ -->
                    <TextBlock Text="▸ FATTURAZIONE" Style="{StaticResource DettaglioSezioneStyle}"/>

                    <!-- Riga: Fattura, Data Fattura, Importo Fattura -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fattura:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Fattura, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data Fattura:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.DataFattura, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Importo Fattura:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.ImportoFattura, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- ══════════ BDC / COLLAUDO ══════════ -->
                    <TextBlock Text="▸ BDC / COLLAUDO" Style="{StaticResource DettaglioSezioneStyle}"/>

                    <!-- Riga: BDC, Data BDC, Collaudo -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BDC:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Bdc, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data BDC:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.DataBdc, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Collaudo:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.Collaudo, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- ══════════ ALTRO ══════════ -->
                    <TextBlock Text="▸ ALTRO" Style="{StaticResource DettaglioSezioneStyle}"/>

                    <!-- Riga: PdC, PdG -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PdC (Piano di Classificazione):" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.PdC, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PdG (Punto di Contratto):" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding MarsauSelezionato.PdG, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Cartella + Sfoglia -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Cartella:" Style="{StaticResource FormLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding MarsauSelezionato.Cartella, Mode=OneWay}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>


                        </Grid>
                    </StackPanel>

                    <!-- Note -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Note:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Note, Mode=OneWay}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 IsReadOnly="True"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <!-- Pulsanti: TRASMISSIONE a sinistra, gli altri a destra -->
                    <Grid Margin="0,20,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding TrasmissioneCommand}"
                                Padding="20,8"
                                Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,4 L14,4 L14,13 L2,13 Z M2,4 L8,9 L14,4"
                                      Stroke="#0F2044"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="TRASMISSIONE" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding OpenCartellaCommand}"
                                    Padding="20,8"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,5 L7,5 L9,7 L14,7 L14,13 L2,13 Z"
                                          Stroke="#0F2044"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"/>
                                    <TextBlock Text="APRI CARTELLA" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding OpenModificaCommand}"
                                    Padding="20,8"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,2 L16,6 L7,15 L2,16 L3,11 Z M10,4 L14,8 M3,11 L7,15"
                                          Stroke="#0F2044"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"/>
                                    <TextBlock Text="MODIFICA DATI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding StampaCommand}"
                                    Padding="20,8"
                                    Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,2 L12,2 L12,6 L4,6 Z M2,6 L14,6 L14,11 L2,11 Z M4,11 L12,11 L12,15 L4,15 Z"
                                          Stroke="#0F2044"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"/>
                                    <TextBlock Text="STAMPA" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== FORM INSERIMENTO ========== -->
            <Border x:Name="BorderForm"
                    Grid.Column="1"
                    Background="#E60F2044"
                    Margin="12"
                    Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxWidth="1000" Margin="16,10,16,20">

                        <!-- Titolo form -->
                        <Border Background="{StaticResource NavyMedium}"
                                BorderBrush="{StaticResource Gold}"
                                BorderThickness="0,0,0,2"
                                Padding="20,14"
                                Margin="0,0,0,24">
                            <TextBlock Text="INSERISCI NUOVO MARSAU"
                                       Foreground="{StaticResource Gold}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- ══════════ DATI IDENTIFICATIVI ══════════ -->
                        <TextBlock Text="▸ DATI IDENTIFICATIVI"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Marsau:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Marsau, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data Marsau:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.MarsauData, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ditta:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ditta, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RDO(Richiesta di Offerta):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Rdo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Argomento:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding NuovoMarsau.Argomento, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Atto:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Atto, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Contratto:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Contratto, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ RICHIESTA E IMPORTI ══════════ -->
                        <TextBlock Text="▸ RICHIESTA E IMPORTI"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Richiesta:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Richiesta, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Lotto:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Lotto, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- CAPITOLO su riga dedicata -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Capitolo:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding NuovoMarsau.Capitolo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Importo:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Importo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giorni:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Giorni, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="RIC:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ric, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DEC, RUP, A.A, A.D -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DEC:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Dec, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RUP:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Rup, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="A.A:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.AA, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="A.D:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ad, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ FORNITURE E SISTEMA ══════════ -->
                        <TextBlock Text="▸ FORNITURE E SISTEMA"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Forniture:" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox SelectedValuePath="Content"
                                      SelectedValue="{Binding NuovoMarsau.Forniture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormComboBoxStyle}">
                                <ComboBoxItem Content="Parziale"/>
                                <ComboBoxItem Content="Completo"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Siga45:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding NuovoMarsau.Siga45, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <!-- ══════════ CRE / DDT / JOSH ══════════ -->
                        <TextBlock Text="▸ CRE / DDT / JOSH"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CRE:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Cre, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data CRE:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataCre, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Josh:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Josh, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DDT, Data DDT, Pervenuto -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DDT(Documento di trasporto):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ddt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data DDT:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataDdt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Pervenuto:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Pervenuto, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DDT 2, Data DDT 2, Pervenuto 2 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DDT 2:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ddt2, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data DDT 2:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataDdt2, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Pervenuto 2:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Pervenuto2, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DDT 3, Data DDT 3, Pervenuto 3 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DDT 3:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Ddt3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data DDT 3:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataDdt3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Pervenuto 3:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Pervenuto3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- (vuoto sotto DDT), Data Introduzione, Trasmesso -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data Introduzione:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataIntroduzione, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Trasmesso:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Trasmesso, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ FATTURAZIONE ══════════ -->
                        <TextBlock Text="▸ FATTURAZIONE"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fattura:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Fattura, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data Fattura:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataFattura, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Importo Fattura:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.ImportoFattura, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ BDC / COLLAUDO ══════════ -->
                        <TextBlock Text="▸ BDC / COLLAUDO"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="BDC:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Bdc, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data BDC:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.DataBdc, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Collaudo:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.Collaudo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ ALTRO ══════════ -->
                        <TextBlock Text="▸ ALTRO"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PdC (Piano di Classificazione):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.PdC, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PdG (Punto di Contratto):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding NuovoMarsau.PdG, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════ CARTELLA DOCUMENTI ══════════ -->
                        <TextBlock Text="▸ CARTELLA DOCUMENTI"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Percorso cartella:" Style="{StaticResource FormLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding CartellaPath}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         IsReadOnly="True"/>

                            </Grid>
                        </StackPanel>

                        <!-- ══════════ NOTE ══════════ -->
                        <TextBlock Text="▸ NOTE"
                                   Foreground="{StaticResource GoldLight}"
                                   FontSize="13" FontWeight="Bold"
                                   Margin="0,16,0,12"/>

                        <StackPanel Margin="0,0,0,24">
                            <TextBox Text="{Binding NuovoMarsau.Note, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormMultilineTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Pulsanti -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="✓ Salva"
                                    Command="{Binding SalvaCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,10,0"
                                    MinWidth="120"/>
                            <Button Content="✗ Annulla"
                                    Command="{Binding AnnullaCommand}"
                                    Style="{StaticResource CancelButtonStyle}"
                                    MinWidth="120"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
