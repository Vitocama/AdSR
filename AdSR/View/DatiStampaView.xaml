<Window x:Class="AdSR.StampaControl.DatiStampaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dati per la stampa"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F2044">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        
      

       
       

        
    </Window.Resources>

    <StackPanel>
        <!-- HEADER -->
        <Border Background="{StaticResource NavyMedium}"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2" Padding="16,10">
            <TextBlock Text="Dati per la stampa" FontSize="17" FontWeight="Bold"
                       Foreground="{StaticResource Gold}"/>
        </Border>

        <StackPanel Margin="20,6,20,20">

            <!-- CAMPI FOGLIO COLLAUDO -->
            <StackPanel Visibility="{Binding IsCollaudo, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Mat. collaudato:" Style="{StaticResource LabelStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Parziale" GroupName="Fornitura"
                                 IsChecked="{Binding Parziale, Mode=TwoWay}"/>
                    <RadioButton Content="Completo" GroupName="Fornitura"
                                 IsChecked="{Binding Completo, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Text="Numero colli (0 = non stampare):" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding NumeroColli, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfermaCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>

            <!-- CAMPI FOGLIO TRASMISSIONE -->
            <StackPanel Visibility="{Binding IsTrasmissione, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Indirizzo ditta:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Indirizzo, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="70"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="gg:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Giorni, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Nome firmatario (2° Settore Ass. Amm.vo Sala Ricezione ):" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding NomeFirmatario, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfermaCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>

            <!-- Pulsanti -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="CONFERMA E STAMPA" Style="{StaticResource ButtonStyle}"
                        Command="{Binding ConfermaCommand}"/>
                <Button Content="ANNULLA" Style="{StaticResource CancelButtonStyle}"
                        Command="{Binding AnnullaCommand}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>