<Window x:Class="AdSR.StampaControl.DatiStampaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dati per la stampa"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F2044">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="Gold" Color="#C9A84C"/>
        <SolidColorBrush x:Key="NavyMedium" Color="#2A456E"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#162840"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,30,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F2044"/>
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="CancelButtonStyle" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- HEADER -->
        <Border Background="{StaticResource NavyMedium}"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2" Padding="16,10">
            <TextBlock Text="Dati per la stampa" FontSize="17" FontWeight="Bold"
                       Foreground="{StaticResource Gold}"/>
        </Border>

        <StackPanel Margin="20,6,20,20">

            <!-- CAMPI FOGLIO COLLAUDO -->
            <StackPanel Visibility="{Binding IsCollaudo, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Mat. collaudato:" Style="{StaticResource LabelStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Parziale" GroupName="Fornitura"
                                 IsChecked="{Binding Parziale, Mode=TwoWay}"/>
                    <RadioButton Content="Completo" GroupName="Fornitura"
                                 IsChecked="{Binding Completo, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Text="Numero colli (0 = non stampare):" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding NumeroColli, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfermaCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>

            <!-- CAMPI FOGLIO TRASMISSIONE -->
            <StackPanel Visibility="{Binding IsTrasmissione, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Indirizzo ditta:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Indirizzo, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="70"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="gg:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Giorni, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Nome firmatario (2° Settore Ass. Amm.vo Sala Ricezione ):" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding NomeFirmatario, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfermaCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>

            <!-- Pulsanti -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="CONFERMA E STAMPA" Style="{StaticResource ButtonStyle}"
                        Command="{Binding ConfermaCommand}"/>
                <Button Content="ANNULLA" Style="{StaticResource CancelButtonStyle}"
                        Command="{Binding AnnullaCommand}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>