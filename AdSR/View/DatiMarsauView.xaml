<Window x:Class="AdSR.DatiMarsau.DatiMarsauView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdSR.DatiMarsau"
        xmlns:common="clr-namespace:AdSR.Common"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Dettagli Marsau" Height="800" Width="1300"
        Background="#0F2044"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>


        <common:TroncaMarsauConverter x:Key="TroncaMarsauConverter"/>


    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SFONDO: foto Marina (Images/marina.jpg, Azione di compilazione = Resource) -->
        <Grid.Background>
            <ImageBrush ImageSource="/IMG/NavePa.jpeg"
                        Stretch="UniformToFill"
                        AlignmentX="Center" AlignmentY="Center"/>
        </Grid.Background>

        <!-- VELO navy sopra la foto: garantisce la leggibilità dei campi -->
        <Border Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E60F2044" Offset="0"/>
                    <GradientStop Color="#B30F2044" Offset="0.4"/>
                    <GradientStop Color="#F20F2044" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#D92A456E"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2" Padding="16,12">
            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Gold}">
                <Run Text="Dettagli Marsau - "/>
                <Run Text="{Binding MarsauSelezionato.Marsau, Converter={StaticResource TroncaMarsauConverter}, Mode=OneWay}"/>
            </TextBlock>
        </Border>

        <!-- CONTENUTO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,10,0,10">
            <StackPanel Width="1100" HorizontalAlignment="Center">

                <!-- ══════════ DATI IDENTIFICATIVI ══════════ -->
                <TextBlock Text="▸ DATI IDENTIFICATIVI" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Riga: Marsau, Data Marsau -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Marsau:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Marsau, Converter={StaticResource TroncaMarsauConverter}, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Marsau:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.MarsauData, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: Ditta, RDO -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ditta:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Ditta, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RDO:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Rdo, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ ARGOMENTO (multilinea) ══════════ -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Argomento:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.Argomento, Mode=OneWay}"
                             Style="{StaticResource InputStyle}"
                             IsReadOnly="True"
                             Height="120"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>
                </StackPanel>

                <!-- Riga: Atto, Contratto -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Atto:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Atto, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Contratto:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Contratto, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ RICHIESTA E IMPORTI ══════════ -->
                <TextBlock Text="▸ RICHIESTA E IMPORTI" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Riga: Richiesta, Lotto, Capitolo -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Richiesta:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Richiesta, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Lotto:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Lotto, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Capitolo:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Capitolo, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: Importo, Giorni, RIC -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Importo:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Importo, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Giorni:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Giorni, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="RIC:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Ric, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: DEC, RUP, A.A, A.D -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DEC:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Dec, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RUP:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Rup, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="A.A:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.AA, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="A.D:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Ad, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ FORNITURE E SISTEMA ══════════ -->
                <TextBlock Text="▸ FORNITURE E SISTEMA" Style="{StaticResource SectionHeaderStyle}"/>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Forniture:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.Forniture, Mode=OneWay}"
                             Style="{StaticResource InputStyle}"
                             IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Siga45:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.Siga45, Mode=OneWay}"
                             Style="{StaticResource InputStyle}"
                             IsReadOnly="True"/>
                </StackPanel>

                <!-- ══════════ CRE / DDT / JOSH ══════════ -->
                <TextBlock Text="▸ CRE / DDT / JOSH" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Riga: CRE, Data CRE, Josh -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CRE:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Cre, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data CRE:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataCre, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Josh:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Josh, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: DDT, Data DDT, Pervenuto -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DDT (Documento di Trasporto):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Ddt, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data DDT:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataDdt, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Pervenuto:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Pervenuto, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: DDT 2, Data DDT 2, Pervenuto 2 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DDT 2:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Ddt2, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data DDT 2:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataDdt2, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Pervenuto 2:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Pervenuto2, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: DDT 3, Data DDT 3, Pervenuto 3 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DDT 3:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Ddt3, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data DDT 3:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataDdt3, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Pervenuto 3:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Pervenuto3, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- Riga: (vuoto sotto DDT), Data Introduzione, Trasmesso -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Introduzione:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataIntroduzione, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Trasmesso:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Trasmesso, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ FATTURAZIONE ══════════ -->
                <TextBlock Text="▸ FATTURAZIONE" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Riga: Fattura, Data Fattura, Importo Fattura -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fattura:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Fattura, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Fattura:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataFattura, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Importo Fattura:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.ImportoFattura, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ BDC / COLLAUDO ══════════ -->
                <TextBlock Text="▸ BDC / COLLAUDO" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Riga: BDC, Data BDC, Collaudo -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BDC:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Bdc, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data BDC:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.DataBdc, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Collaudo:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.Collaudo, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════ ALTRO ══════════ -->
                <TextBlock Text="▸ ALTRO" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Riga: PdC, PdG -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PdC (Piano di Classificazione):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.PdC, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PdG (Punto di Contratto):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MarsauSelezionato.PdG, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- Cartella + Sfoglia -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Cartella:" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding MarsauSelezionato.Cartella, Mode=OneWay}"
                                 Style="{StaticResource InputStyle}"
                                 IsReadOnly="True"/>

                    
                    </Grid>
                </StackPanel>

                <!-- Note -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Note:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding MarsauSelezionato.Note, Mode=OneWay}"
                             Style="{StaticResource InputStyle}"
                             IsReadOnly="True"
                             Height="80"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Pulsanti: TRASMISSIONE a sinistra, gli altri a destra -->
                <Grid Margin="0,20,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource ButtonStyle}"
                            Command="{Binding TrasmissioneCommand}"
                            Padding="20,8"
                            Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,4 L14,4 L14,13 L2,13 Z
                                        M2,4 L8,9 L14,4"
                                  Stroke="#0F2044"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="TRASMISSIONE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonStyle}"
                                Command="{Binding OpenCartellaCommand}"
                                Padding="20,8"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,5 L7,5 L9,7 L14,7 L14,13 L2,13 Z"
                                      Stroke="#0F2044"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="APRI CARTELLA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ButtonStyle}"
                                Command="{Binding OpenModificaCommand}"
                                Padding="20,8"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2 L16,6 L7,15 L2,16 L3,11 Z
                                            M10,4 L14,8
                                            M3,11 L7,15"
                                      Stroke="#0F2044"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="MODIFICA DATI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ButtonStyle}"
                                Command="{Binding StampaCommand}"
                                Padding="20,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,2 L12,2 L12,6 L4,6 Z
                                            M2,6 L14,6 L14,11 L2,11 Z
                                            M4,11 L12,11 L12,15 L4,15 Z"
                                      Stroke="#0F2044"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="STAMPA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>