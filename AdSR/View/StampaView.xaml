<Window x:Class="AdSR.StampaControl.StampaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Titolo}" Height="900" Width="950"
        Background="#0F2044"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="Gold" Color="#C9A84C"/>
        <SolidColorBrush x:Key="NavyMedium" Color="#2A456E"/>

        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F2044"/>
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="CancelButtonStyle" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA COMANDI -->
        <Border Grid.Row="0" Background="{StaticResource NavyMedium}"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2" Padding="16,10">
            <DockPanel>
                <TextBlock Text="{Binding Titolo}"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource Gold}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ButtonStyle}" Command="{Binding StampaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,2 L12,2 L12,6 L4,6 Z M2,6 L14,6 L14,11 L2,11 Z M4,11 L12,11 L12,15 L4,15 Z"
                                  Stroke="#0F2044" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Fill="Transparent" Width="16" Height="16" Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="STAMPA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CancelButtonStyle}" Command="{Binding ChiudiCommand}"
                            Content="CHIUDI"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ANTEPRIMA: foglio bianco centrato dentro uno ScrollViewer -->
        <ScrollViewer Grid.Row="1"
                      Background="#3A4A66"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Padding="20">
            <Border Background="White" Width="794" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <FlowDocumentScrollViewer Document="{Binding DocumentoStampa}"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False"/>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>