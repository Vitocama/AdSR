<Window x:Class="AdSR.StampaControl.StampaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdSR.StampaControl"
        mc:Ignorable="d"
        Title="Anteprima di Stampa - Marsau" Height="850" Width="820"
        Background="#0F2044"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="Gold" Color="#C9A84C"/>
        <SolidColorBrush x:Key="GoldLight" Color="#E8C97A"/>
        <SolidColorBrush x:Key="NavyDark" Color="#0F2044"/>
        <SolidColorBrush x:Key="NavyMedium" Color="#2A456E"/>

        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F2044"/>
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="CancelButtonStyle" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource NavyDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource NavyMedium}"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2" Padding="16,12">
            <TextBlock Text="Anteprima di Stampa"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Gold}"/>
        </Border>

        <!-- ANTEPRIMA DOCUMENTO -->
        <Border Grid.Row="1" Background="#FFFFFF" Margin="16,12,16,12">
            <FlowDocumentScrollViewer
                x:Name="AnteprimaViewer"
                Document="{Binding DocumentoStampa}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Zoom="100"/>
        </Border>

        <!-- BARRA PULSANTI FISSA IN BASSO -->
        <Border Grid.Row="2" Background="{StaticResource NavyMedium}"
                BorderBrush="{StaticResource Gold}" BorderThickness="0,2,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Style="{StaticResource ButtonStyle}"
                        Command="{Binding StampaCommand}"
                        Padding="20,8"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M4,2 L12,2 L12,6 L14,6 L14,11 L11,11 L11,14 L5,14 L5,11 L2,11 L2,6 L4,6 Z
                                    M6,3 L10,3 L10,6 L6,6 Z
                                    M6,12 L10,12 L10,13 L6,13 Z"
                              Stroke="#0F2044"
                              StrokeThickness="1.2"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="STAMPA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CancelButtonStyle}"
                        Command="{Binding ChiudiCommand}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Stroke="#FFFFFF"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="CHIUDI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>