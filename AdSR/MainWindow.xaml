<Window x:Class="AdSR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdSR"
        Title="AdSR - Acquisizione Dati Sala Ricezione" Height="808" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

   

   
    <Grid Background="{StaticResource MainGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Background="#F4F4F6">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="3"/>
            </Grid.RowDefinitions>

            <Image Source="/IMG/ministero-difesa-logo.png"/>

           

            <Rectangle Grid.Row="1" Fill="{StaticResource GoldLineGradient}"/>
        </Grid>

        <!-- ═══ MIDDLE ═══ -->
   

        <Rectangle Grid.Row="2" Fill="{StaticResource GoldLineGradient}"/>

        <!-- ═══ BODY ═══ -->
        <Grid Grid.Row="3">
            <Grid.Background>
                <ImageBrush ImageSource="/IMG/logo_pantano.png" Stretch="Fill"/>
            </Grid.Background>

            <!-- VELO che rende opaco lo sfondo -->
            <Rectangle Fill="#0F2044" Opacity="0.55" IsHitTestVisible="False"/>

            <!-- Titolo in alto -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                <TextBlock Text="MARINARSEN - Acquisizione Dati Sala Ricezione"
                           FontFamily="Palatino Linotype" FontSize="15" FontWeight="Bold"
                           Foreground="#E8C97A" HorizontalAlignment="Center" Opacity="0.85"/>
                <Rectangle Height="1" Width="340" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C9A84C" Offset="0"/>
                            <GradientStop Color="#C9A84C"   Offset="0.5"/>
                            <GradientStop Color="#00C9A84C" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </StackPanel>

            <!-- ═══ PANNELLO STATO DATABASE ═══ -->
            <Border Width="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#D90F2044"
                    BorderBrush="{StaticResource Gold}" BorderThickness="1"
                    CornerRadius="8" Padding="32,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="▸ DATABASE"
                               FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource GoldLight}"/>

                    <Rectangle Height="1" Fill="{StaticResource GoldLineGradient}" Margin="0,10,0,22"/>

                    <!-- LED stato connessione -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#E04B4B"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#E04B4B" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connesso}" Value="True">
                                            <Setter Property="Fill" Value="#3FCF6A"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#3FCF6A" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding InVerifica}" Value="True">
                                            <Setter Property="Fill" Value="#E8C97A"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#E8C97A" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="NON COLLEGATO"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connesso}" Value="True">
                                            <Setter Property="Text" Value="COLLEGATO"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding InVerifica}" Value="True">
                                            <Setter Property="Text" Value="VERIFICA IN CORSO..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Dettaglio stato -->
                    <TextBlock Text="{Binding Stato}"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#C8D3E6" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="{Binding PercorsoDb}"
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="#80C8D3E6" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               ToolTip="{Binding PercorsoDb}"
                               Margin="0,4,0,0"/>

                    <!-- Pulsanti -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Content="RIPROVA"
                                Style="{StaticResource GoldButton}"
                                Command="{Binding VerificaCommand}"
                                Margin="0,0,12,0"/>
                        <Button Content="CONSULTA DATABASE"
                                Style="{StaticResource GoldButton}"
                                Command="{Binding EntraCommand}"
                                IsEnabled="{Binding Connesso}"
                                Padding="32,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer in basso -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                <Rectangle Height="1" Width="300" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C9A84C" Offset="0"/>
                            <GradientStop Color="#C9A84C"   Offset="0.5"/>
                            <GradientStop Color="#00C9A84C" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="ARSENALE MILITARE MARITTIMO"
                           FontFamily="Segoe UI" FontSize="10"
                           Foreground="#80C9A84C" HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema di Acquisizione Dati Sala Ricezione"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Light"
                           Foreground="#60FFFFFF" HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>