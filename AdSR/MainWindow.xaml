<Window x:Class="AdSR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdSR.MenuControl"
        Title="MainWindow" Height="808" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <LinearGradientBrush x:Key="MainGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F2044" Offset="0"/>
            <GradientStop Color="#162D5C" Offset="0.5"/>
            <GradientStop Color="#1A3870" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldLineGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00C9A84C" Offset="0"/>
            <GradientStop Color="#C9A84C"   Offset="0.3"/>
            <GradientStop Color="#C9A84C"   Offset="0.7"/>
            <GradientStop Color="#00C9A84C" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Gold"      Color="#C9A84C"/>
        <SolidColorBrush x:Key="GoldLight" Color="#E8C97A"/>
    </Window.Resources>

    <Grid Background="{StaticResource MainGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Background="#F4F4F6">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="3"/>
            </Grid.RowDefinitions>

            <Image Source="/IMG/ministero-difesa-logo.png"/>

            <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
                <Polygon Points="0,0 40,0 0,40" Fill="#0A1628" Opacity="0.06"/>
                <Polygon Points="0,0 40,0 40,40" Canvas.Right="0" Fill="#0A1628" Opacity="0.06"/>
                <Rectangle Canvas.Left="6" Canvas.Top="6" Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="#C9A84C" Opacity="0.35"/>
                <Rectangle Canvas.Right="6" Canvas.Top="6" Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="#C9A84C" Opacity="0.35"/>
            </Canvas>

            <DockPanel Grid.Row="0" Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Width="40" Height="40" CornerRadius="3" BorderBrush="#0A1628" BorderThickness="2" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Column="0" Grid.Row="0" Fill="#C8102E"/>
                            <Rectangle Grid.Column="1" Grid.Row="0" Fill="White"/>
                            <Rectangle Grid.Column="0" Grid.Row="1" Fill="#006CB7"/>
                            <Rectangle Grid.Column="1" Grid.Row="1" Fill="#C8102E"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MINISTERO DELLA DIFESA" FontFamily="Segoe UI" FontSize="8.5" FontWeight="Normal" Foreground="#777777"/>
                        <TextBlock Text="Marina Militare" FontFamily="Palatino Linotype" FontSize="15" FontWeight="SemiBold" Foreground="#0A1628"/>
                    </StackPanel>
                    <Rectangle Width="1" Height="36" Fill="#DDDDDD" Margin="16,0"/>
                    <TextBlock Text="MARINARSEN · Gestione Personale e Attestati" FontFamily="Segoe UI" FontSize="11" FontWeight="Light" Foreground="#666666" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Border Background="#0A1628" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="2" Padding="14,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#C9A84C" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="SAOResoForm" FontFamily="Segoe UI" FontSize="10" FontWeight="Medium" Foreground="{StaticResource GoldLight}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <Rectangle Grid.Row="1" Fill="{StaticResource GoldLineGradient}"/>
        </Grid>

        <!-- ═══ MIDDLE ═══ -->
        <Grid Grid.Row="1">
            <Canvas IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Polygon Points="0,0 24,0 0,28"  Fill="#C9A84C" Opacity="0.28"/>
                <Polygon Points="26,0 42,0 26,20" Fill="#C9A84C" Opacity="0.14"/>
                <Rectangle Canvas.Left="44" Canvas.Top="0" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#C9A84C" Opacity="0.25"/>
            </Canvas>
            <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Polygon Points="42,0 0,0 42,28"  Fill="#C9A84C" Opacity="0.28"/>
                <Polygon Points="16,0 0,0 16,20"  Fill="#C9A84C" Opacity="0.14"/>
                <Rectangle Canvas.Right="44" Canvas.Top="0" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#C9A84C" Opacity="0.25"/>
            </Canvas>
        </Grid>

        <Rectangle Grid.Row="2" Fill="{StaticResource GoldLineGradient}"/>

        <!-- ═══ BODY ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ MENU ═══ -->
            <Grid Grid.Column="0">
                <local:MenuView/>
                <Canvas IsHitTestVisible="False">
                    <Polygon Points="190,0 220,0 220,28" Fill="#C9A84C" Opacity="0.18" Canvas.Left="0" Canvas.Top="0"/>
                    <Polygon Points="202,0 220,0 220,18" Fill="#C9A84C" Opacity="0.10" Canvas.Left="0" Canvas.Top="0"/>
                    <Polygon Points="190,0 220,0 220,28" Fill="#C9A84C" Opacity="0.18" Canvas.Left="0" Canvas.Bottom="0" RenderTransformOrigin="0.5,0.5">
                        <Polygon.RenderTransform>
                            <ScaleTransform ScaleY="-1"/>
                        </Polygon.RenderTransform>
                    </Polygon>
                    <Ellipse Canvas.Left="30" Canvas.Top="0" Width="160" Height="160" Stroke="#C9A84C" StrokeThickness="0.6" Fill="Transparent" Opacity="0.08"/>
                    <Rectangle Canvas.Right="0" Canvas.Top="40" Width="2" Height="120" Fill="#C9A84C" Opacity="0.22"/>
                    <Rectangle Canvas.Left="10" Canvas.Bottom="60" Width="10" Height="10" RadiusX="2" RadiusY="2" Stroke="#C9A84C" StrokeThickness="1" Fill="Transparent" Opacity="0.30"/>
                    <Rectangle Canvas.Left="24" Canvas.Bottom="66" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#C9A84C" Opacity="0.20"/>
                    <Rectangle Canvas.Left="10" Canvas.Bottom="44" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#C9A84C" Opacity="0.20"/>
                    <Ellipse Canvas.Left="36" Canvas.Bottom="50" Width="8" Height="8" Stroke="#C9A84C" StrokeThickness="0.8" Fill="Transparent" Opacity="0.20"/>
                </Canvas>
            </Grid>

            <!-- ═══ AREA PRINCIPALE ═══ -->
            <Grid Grid.Column="1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A456E" Offset="0"/>
                        <GradientStop Color="#0E1E3E" Offset="0.5"/>
                        <GradientStop Color="#19397F" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Layout interno -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colonna centrale con immagine di sfondo -->
                    <Grid Grid.Column="1">
                        <Grid.Background>
                            <ImageBrush ImageSource="/IMG/somm.png" Stretch="UniformToFill"/>
                        </Grid.Background>

                        <!-- Header testuale in alto -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                            <TextBlock Text="MARINARSEN - Acquisizione Dati Sala Ricezione"
                                       FontFamily="Palatino Linotype" FontSize="15" FontWeight="Bold"
                                       Foreground="#E8C97A" HorizontalAlignment="Center" Opacity="0.85"/>
                            <Rectangle Height="1" Width="340" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00C9A84C" Offset="0"/>
                                        <GradientStop Color="#C9A84C"   Offset="0.5"/>
                                        <GradientStop Color="#00C9A84C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </StackPanel>

                        <!-- Footer testuale in basso -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                            <Rectangle Height="1" Width="300" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00C9A84C" Offset="0"/>
                                        <GradientStop Color="#C9A84C"   Offset="0.5"/>
                                        <GradientStop Color="#00C9A84C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="ARSENALE MILITARE MARITTIMO"
                                       FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#50C9A84C" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sistema di Acquisizione Dati Sala Ricezione"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Light"
                                       Foreground="#35FFFFFF" HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
