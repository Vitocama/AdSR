<Window x:Class="AdSR.Common.MarinaMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="480"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

   

        <!-- Margine esterno per lasciare spazio all'ombra -->
    <Border Margin="16"
            Background="#0F2044"
            BorderBrush="{StaticResource MsgGold}" BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.7" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER (trascinabile): titolo a sinistra, stemma a destra -->
            <Border Grid.Row="0" Background="#2A456E" CornerRadius="8,8,0,0"
                    Padding="18,8" Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <Image DockPanel.Dock="Right"
                           Source="/IMG/stemma.png"
                           Height="36"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock x:Name="TxtTitolo"
                               FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource MsgGoldLight}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <Rectangle Grid.Row="0" Height="2" VerticalAlignment="Bottom"
                       Fill="{StaticResource MsgGoldLine}"/>

            <!-- CORPO: icona + messaggio -->
            <Grid Grid.Row="1" Margin="22,22,22,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconaBox"
                        Width="44" Height="44" CornerRadius="22"
                        VerticalAlignment="Top" Margin="0,0,18,0">
                    <Border.Effect>
                        <DropShadowEffect x:Name="IconaGlow" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                    <TextBlock x:Name="IconaGlifo"
                               FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Column="1" MaxHeight="300"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtMessaggio"
                               FontFamily="Segoe UI" FontSize="14"
                               Foreground="#E8EEF5" TextWrapping="Wrap"
                               VerticalAlignment="Center" LineHeight="20"/>
                </ScrollViewer>
            </Grid>

            <!-- PULSANTI -->
            <StackPanel x:Name="PannelloPulsanti" Grid.Row="2"
                        Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="22,14,22,20"/>
        </Grid>
    </Border>
</Window>